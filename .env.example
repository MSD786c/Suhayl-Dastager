# ──────────────────────────────────────────────────────────────
# Suhayl Dastager — personal website
# Copy this file to `.env.local` and fill in the values below.
# All contact form emails are sent via Zoho SMTP. Without these
# the form still works in dev (it logs the payload) but no email
# is actually delivered.
# ──────────────────────────────────────────────────────────────

# Where inbound contact emails go (you, the site owner).
CONTACT_TO_EMAIL="dastagersuhayl@gmail.com"

# Optional override for the From: address. If left blank, the
# server constructs one from your site URL + noreply@.
# CONTACT_FROM_EMAIL="Suhayl Dastager Website <noreply@suhayl-dastager.me>"

# ─── Zoho SMTP ───────────────────────────────────────────────
# Get these from https://mail.zoho.com → Settings → POP/IMAP
# Use a Zoho-issued App Password if you have 2FA enabled.
ZOHO_SMTP_HOST="smtp.zoho.com"
ZOHO_SMTP_PORT="465"
ZOHO_SMTP_USER=""
ZOHO_SMTP_PASSWORD=""

# ─── Site (optional overrides) ───────────────────────────────
# Defaults are in lib/personal-brand.ts. Set these only if you
# need to point to a staging URL or alternate domain.
# NEXT_PUBLIC_SITE_URL="https://suhayl-dastager.me"
